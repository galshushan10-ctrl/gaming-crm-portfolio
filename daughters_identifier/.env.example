# Twilio – לשליחת WhatsApp
# קבל ב: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# מספר הטלפון שלך (לקבל התראות)
WHATSAPP_TO=+972501234567

# מספר Twilio WhatsApp sandbox (זה המספר הקבוע של sandbox)
WHATSAPP_FROM=+14155238886

# Cloudinary – להעלאת תמונות כדי לשלוח ב-WhatsApp (אופציונלי)
# קבל ב: https://cloudinary.com (חינמי)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
